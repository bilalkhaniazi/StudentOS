DATABASE_URL=postgresql://studentos:studentos@127.0.0.1:54329/studentos
API_HOST=0.0.0.0
API_PORT=43124
WEB_PORT=43123
API_INTERNAL_URL=http://127.0.0.1:43124
CATALOG_YEAR=2026-2027

# Google sign-in (do not commit a filled-in .env)
# Create an OAuth client in Google Cloud. Authorized JavaScript origin:
#   http://127.0.0.1:43123
# Authorized redirect URI:
#   http://127.0.0.1:43123/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_SECRET=
AUTH_URL=http://127.0.0.1:43123
AUTH_TRUST_HOST=true

# Comma-separated email domains (no @). Change this one line to adjust who can sign in.
ALLOWED_EMAIL_DOMAINS=mail.gvsu.edu,gvsu.edu

# Optional local bypass. Leave false unless you are developing without Google keys.
NEXT_PUBLIC_DEV_LOGIN=false
